# nextapp 환경변수 예시 — 실제 값은 nextapp/.env.local 에 넣는다 (git 추적 안 됨)

# Supabase > 프로젝트 > Settings > Database > Connection string
#   "Transaction" 탭(포트 6543, 커넥션 풀러) URI 를 복사.
#   [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣고, 끝에 ?sslmode=require 를 붙인다.
DATABASE_URL=

# IP 해시용 소금(아무 긴 랜덤 문자열). 예: 터미널에서  openssl rand -hex 32
GUESTBOOK_IP_SALT=
